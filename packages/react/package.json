{
  "name": "@logoicon/react",
  "version": "1.0.12",
  "description": "react component of logoicon",
  "keywords": [
    "logo icon",
    "logo",
    "icon"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/dembilesmana/logoicon.git"
  },
  "license": "MIT",
  "author": {
    "name": "dembilesmana",
    "email": "dembilesmana@gmail.com",
    "url": "https://dembilesmana.vercel.app"
  },
  "sideEffects": true,
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./metadata": {
      "import": {
        "types": "./dist/metadata.d.ts",
        "default": "./dist/metadata.js"
      },
      "require": {
        "types": "./dist/metadata.d.cts",
        "default": "./dist/metadata.cjs"
      }
    }
  },
  "files": [
    "./dist",
    "./CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "generate": "tsx ./scripts/generate.ts",
    "tsc": "tsc -p ./tsconfig.json"
  },
  "devDependencies": {
    "@logoicon/core": "workspace:^",
    "@logoicon/eslintconfig": "workspace:^",
    "@logoicon/logger": "workspace:^",
    "@logoicon/tsconfig": "workspace:^",
    "@logoicon/util": "workspace:^",
    "@types/react": "^19.1.17",
    "react": "19.1.0"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
