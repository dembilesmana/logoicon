---
// src/components/CustomLogo.astro
import type { Props } from '@astrojs/starlight/props';
import { config } from '@logoicon/config';
import { Image } from "astro:assets";
import logo from "../assets/logo.svg";

// Anda bisa mengakses data bawaan Starlight via Astro.props jika dibutuhkan
const { slug } = Astro.props;
---

<div class="custom-logo-wrapper">
  <a href={config.url.web}
  class="logo-link">
    <Image src={ logo } alt="Logo" width="64" height="64"/>
  </a>
  <a href="" class="logo-link">
    <span class="site-name">Docs</span>
  </a>
</div>

<style>
  .custom-logo-wrapper {
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  .logo-link {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-weight: bold;
    text-decoration: none;
    color: var(--sl-color-text-accent);
  }
  .site-name {
    font-size: 1.25rem;
    color: var(--sl-color-white);
  }
</style>
